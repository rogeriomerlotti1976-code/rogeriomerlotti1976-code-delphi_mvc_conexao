unit Model.Query.Firedac;

interface

uses
  System.Classes,
  System.SysUtils,
  Data.DB,
  FireDAC.Comp.Client,
  FireDAC.Stan.Param,
  FireDAC.DApt,
  FireDAC.Phys.SQLite,

//  FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error,
//  FireDAC.UI.Intf, FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool,
//  FireDAC.Stan.Async, FireDAC.Phys, FireDAC.Phys.SQLiteDef,
//  FireDAC.Stan.ExprFuncs, FireDAC.VCLUI.Wait, FireDAC.Phys.SQLiteWrapper.Stat,






  Model.Query.Interfaces,
  Model.Conexao.Interfaces;

type
  TModelQueryFiredac = class(TInterfacedObject, iQuery)
  private
    FQuery: TFDQuery;
    constructor Create(AConexao: iConexao);
    procedure SetSQL(AValue: string);
    procedure SetParams(AValue: array of Variant);
  public
    destructor Destroy; override;
    class function New(AConexao: iConexao): iQuery;
    procedure Execute(const AStatement: string; const AParams: array of Variant);
    function Query(const AStatement: string; const AParams: array of Variant): TDataSet;
  end;

implementation

{ TModelQueryFiredac }

constructor TModelQueryFiredac.Create(AConexao: iConexao);
begin
  FQuery := TFDQuery.Create(nil);
  FQuery.Connection := TFDConnection(AConexao.Conexao);
end;

destructor TModelQueryFiredac.Destroy;
begin
  FreeAndNil(FQuery);
  inherited;
end;

class function TModelQueryFiredac.New(AConexao: iConexao): iQuery;
begin
  Result := Self.Create(AConexao);
end;

function TModelQueryFiredac.Query(const AStatement: string;
  const AParams: array of Variant): TDataSet;
begin
  SetSQL(AStatement);
  SetParams(AParams);
  FQuery.Open;
  Result := FQuery;
end;

procedure TModelQueryFiredac.SetParams(AValue: array of Variant);
begin
  for var i := Low(AValue) to High(AValue) do
  begin
    FQuery.Params.Add;
    FQuery.Params[i].Value := AValue[i];
  end;

//  for var i := Low(AValue) to High(AValue) do
//  begin
//    FQuery.Params.Add;
//    FQuery.Params[i].Value := AValue[i];

//
//
//  end;
end;

procedure TModelQueryFiredac.SetSQL(AValue: string);
begin
  FQuery.Close;
  FQuery.SQL.Clear;
  FQuery.SQL.Add(AValue);
end;

procedure TModelQueryFiredac.Execute(const AStatement: string;
  const AParams: array of Variant);
begin
  SetSQL(AStatement);
  SetParams(AParams);
  FQuery.ExecSQL;
end;

end.
