unit Model.Conexao.Configuracao;

interface

uses
  System.SysUtils,
  IniFiles,
  Model.Conexao.Constantes,
  Model.Conexao.Enums,
  Model.Conexao.Interfaces;

type
  TModelConexaoConfiguracao = class(TInterfacedObject, iConfiguracoesConexao)
  const
    SECTION = 'CONEXAO';
    BANCO = 'BANCO';
    CAMINHO = 'CAMINHO';
    PORTA = 'PORTA';
    SERVIDOR = 'SERVIDOR';
    USUARIO = 'USER_NAME';
    SENHA = 'PASSWORD';
    DRIVER_NAME = 'DRIVER_NAME';
    PROTOCOLO_LOCAL = 'LOCAL';
    PROTOCOLO_TCP = 'TCP';
    HOST_LOCAL = 'LOCALHOST';
    IP_LOCALHOST = '127.0.0.1';
  private
    FArquivoIni: TIniFile;
    constructor Create(AFileName: string);
    function IsServidorLocal: Boolean;
    function TipoBancoToString(ATipoBanco: TTipoBanco): string;
    function StringToTipoBanco(AValue: string): TTipoBanco;
  public
    class function New(AFileName: string): iConfiguracoesConexao;
    destructor Destroy; override;
    function TipoBanco(AValue: TTipoBanco): iConfiguracoesConexao; overload;
    function TipoBanco: TTipoBanco; overload;
    function Protocol(AValue: string): iConfiguracoesConexao; overload;
    function Protocol: string; overload;
    function Port(AValue: string): iConfiguracoesConexao; overload;
    function Port: string; overload;
    function Server(AValue: string): iConfiguracoesConexao; overload;
    function Server: string; overload;
    function Path(AValue: string): iConfiguracoesConexao; overload;
    function Path: string; overload;
    function Database(AValue: string): iConfiguracoesConexao; overload;
    function Database: string; overload;
    function UserName(AValue: string): iConfiguracoesConexao; overload;
    function UserName: string; overload;
    function Password(AValue: string): iConfiguracoesConexao; overload;
    function Password: string; overload;
    function DriverName(AValue: string): iConfiguracoesConexao; overload;
    function DriverName: string; overload;
  end;

implementation

{ TModelConexaoConfiguracao }

constructor TModelConexaoConfiguracao.Create(AFileName: string);
begin
  FArquivoIni := TIniFile.Create(AFileName);
end;

function TModelConexaoConfiguracao.Database(
  AValue: string): iConfiguracoesConexao;
begin
  Result := Self;
  FArquivoIni.WriteString(SECTION, DATABASE, AValue);
end;

function TModelConexaoConfiguracao.Database: string;
begin
  Result := FArquivoIni.ReadString(SECTION, DATABASE, '');
end;

destructor TModelConexaoConfiguracao.Destroy;
begin
  FreeAndNil(FArquivoIni);
  inherited;
end;

function TModelConexaoConfiguracao.DriverName(
  AValue: string): iConfiguracoesConexao;
begin
  Result := Self;
  FArquivoIni.WriteString(SECTION, BANCO, AValue);
end;

function TModelConexaoConfiguracao.DriverName: string;
begin
  Result := FArquivoIni.ReadString(SECTION, BANCO, '');
end;

function TModelConexaoConfiguracao.IsServidorLocal: Boolean;
begin
  Result := (FArquivoIni.ReadString(SECTION, SERVIDOR, '') = HOST_LOCAL) or
    (FArquivoIni.ReadString(SECTION, SERVIDOR, '') = IP_LOCALHOST);
end;

class function TModelConexaoConfiguracao.New(AFileName: string): iConfiguracoesConexao;
begin
  Result := Self.Create(AFileName);
end;

function TModelConexaoConfiguracao.Password: string;
begin
  Result := FArquivoIni.ReadString(SECTION, SENHA, '');
end;

function TModelConexaoConfiguracao.Path: string;
begin
  Result := FArquivoIni.ReadString(SECTION, CAMINHO, '');
end;

function TModelConexaoConfiguracao.Port: string;
begin
  Result := FArquivoIni.ReadString(SECTION, PORTA, '');
end;

function TModelConexaoConfiguracao.Port(AValue: string): iConfiguracoesConexao;
begin
  Result := Self;
  FArquivoIni.WriteString(SECTION, PORTA, '');
end;

function TModelConexaoConfiguracao.Path(AValue: string): iConfiguracoesConexao;
begin
  Result := Self;
  FArquivoIni.WriteString(SECTION, CAMINHO, AValue);
end;

function TModelConexaoConfiguracao.Password(
  AValue: string): iConfiguracoesConexao;
begin
  Result := Self;
  FArquivoIni.WriteString(SECTION, SENHA, AValue);
end;

function TModelConexaoConfiguracao.Protocol(
  AValue: string): iConfiguracoesConexao;
begin
  Result := Self;
//  FArquivoIni.WriteString(SECTION, PROTOCOLO)
end;

function TModelConexaoConfiguracao.Protocol: string;
begin
  Result := PROTOCOLO_LOCAL;

  if not IsServidorLocal then
    Result := PROTOCOLO_TCP;

  Result := FArquivoIni.ReadString(SECTION, PROTOCOL, '');
end;

function TModelConexaoConfiguracao.Server: string;
begin
  Result := FArquivoIni.ReadString(SECTION, SERVIDOR, '');
end;

function TModelConexaoConfiguracao.StringToTipoBanco(
  AValue: string): TTipoBanco;
begin
  Result := tbNaoDefinido;

  if SameText(AValue, BANCO_SQLITE) then
    Exit(tbSQLite);

  if SameText(AValue, BANCO_FIREBIRD) then
    Exit(tbFirebird);

  if SameText(AValue, BANCO_MYSQL) then
    Exit(tbMySQL);
end;

function TModelConexaoConfiguracao.TipoBanco: TTipoBanco;
begin
  Result := StringToTipoBanco(FArquivoIni.ReadString(SECTION, BANCO, BANCO_SQLITE));
end;

function TModelConexaoConfiguracao.TipoBancoToString(
  ATipoBanco: TTipoBanco): string;
begin
  case ATipoBanco of
    tbSQLite:
      Result := BANCO_SQLITE;

    tbFirebird:
      Result := BANCO_FIREBIRD;

    tbMySQL:
      Result := BANCO_MYSQL;
  end;
end;

function TModelConexaoConfiguracao.TipoBanco(
  AValue: TTipoBanco): iConfiguracoesConexao;
begin
  Result := Self;
  FArquivoIni.WriteString(SECTION, BANCO, TipoBancoToString(AValue));
end;

function TModelConexaoConfiguracao.Server(
  AValue: string): iConfiguracoesConexao;
begin
  Result := Self;
  FArquivoIni.WriteString(SECTION, SERVIDOR, AValue);
end;

function TModelConexaoConfiguracao.UserName(
  AValue: string): iConfiguracoesConexao;
begin
  Result := Self;
  FArquivoIni.WriteString(SECTION, USUARIO, AValue);
end;

function TModelConexaoConfiguracao.UserName: string;
begin
  Result := FArquivoIni.ReadString(SECTION, USERNAME, '');
end;

end.
