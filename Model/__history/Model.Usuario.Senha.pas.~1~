unit Model.Usuario.Senha;

interface

uses
  System.SysUtils,
  System.Classes,
  System.NetEncoding,
  Winapi.Windows,
  Bcrypt,
  Model.Usuario.Senha.Interfaces;

type
  TModelUsuarioSenha = class(TInterfacedObject, iModelUsuarioSenha)
  private const
    ITERACOES = 100000;
    TAMANHO_SALT = 16;
    TAMANHO_HASH = 32;
    PREFIXO = 'PBKDF2';
    SEPARADOR = '$';
  private
    function GerarSalt: TBytes;
    function DerivarHash(const ASenha: string; const ASalt: TBytes;
      const AIteracoes: Cardinal): TBytes;
    function BytesToBase64(const ABytes: TBytes): string;
    function Base64ToBytes(const AValue: string): TBytes;
  public class
    function New: iModelUsuarioSenha;
    function GerarHash(const ASenha: string): string;
    function ValidarSenha(const ASenha, AHash: string): Boolean;
  end;

implementation

{ TModelUsuarioSenha }

class function TModelUsuarioSenha.New: iModelUsuarioSenha;
begin
  Result := Self.Create;
end;

function TModelUsuarioSenha.GerarSalt: TBytes;
var
  Status: NTSTATUS;
begin
  SetLength(Result, TAMANHO_SALT);

  Status := BCryptGenRandom(nil, @Result[0], Length(Result),
    BCRYPT_USE_SYSTEM_PREFERRED_RNG);

  if Status <> 0 then
    raise Exception.CreateFmt('Não foi possível gerar o salt. Código: %d',
      [Status]);
end;

function TModelUsuarioSenha.DerivarHash(const ASenha: string;
  const ASalt: TBytes; const AIteracoes: Cardinal): TBytes;
var
  Status: NTSTATUS;
  SenhaBytes: TBytes;
begin
  SenhaBytes := TEncoding.UTF8.GetBytes(ASenha);

  SetLength(Result, TAMANHO_HASH);

  Status := BCryptDeriveKeyPBKDF2(BCRYPT_SHA256_ALGORITHM, @SenhaBytes[0],
    Length(SenhaBytes), @ASalt[0], Length(ASalt), AIteracoes, @Result[0],
    Length(Result), 0);

  if Status <> 0 then
    raise Exception.CreateFmt('Não foi possível gerar o hash da senha. Código: %d', [Status]);
end;

function TModelUsuarioSenha.BytesToBase64(const ABytes: TBytes): string;
begin
  Result := TNetEncoding.Base64.EncodeBytesToString(ABytes);
end;

function TModelUsuarioSenha.Base64ToBytes(const AValue: string): TBytes;
begin
  Result := TNetEncoding.Base64.DecodeStringToBytes(AValue);
end;

function TModelUsuarioSenha.GerarHash(const ASenha: string): string;
var
  Salt: TBytes;
  Hash: TBytes;
begin
  if ASenha.Trim.IsEmpty then
    raise Exception.Create('A senha não pode ser vazia.');

  Salt := GerarSalt;

  Hash := DerivarHash(ASenha, Salt, ITERACOES);

  Result := PREFIXO + SEPARADOR + UIntToStr(ITERACOES) + SEPARADOR +
    BytesToBase64(Salt) + SEPARADOR + BytesToBase64(Hash);
end;

function TModelUsuarioSenha.ValidarSenha(const ASenha, AHash: string): Boolean;
var
  Partes: TArray<string>;
  ITERACOES: Cardinal;
  Salt: TBytes;
  HashEsperado: TBytes;
  HashInformado: TBytes;
  I: Integer;
  Diferenca: Byte;
begin
  Result := False;

  if ASenha.IsEmpty then
    Exit;

  if AHash.IsEmpty then
    Exit;

  Partes := AHash.Split([SEPARADOR]);

  if Length(Partes) <> 4 then
    Exit;

  if not SameText(Partes[0], PREFIXO) then
    Exit;

  if not TryStrToUInt(Partes[1], ITERACOES) then
    Exit;

  if ITERACOES = 0 then
    Exit;

  try
    Salt := Base64ToBytes(Partes[2]);
    HashInformado := Base64ToBytes(Partes[3]);

    ` ` ` HashEsperado := DerivarHash(ASenha, Salt, ITERACOES);
    ` ` `

  except
    Exit;
  end;

  if Length(HashEsperado) <> Length(HashInformado) then
    Exit;

  Diferenca := 0;

  for I := 0 to High(HashEsperado) do
    Diferenca := Diferenca or (HashEsperado[I] xor HashInformado[I]);

  Result := Diferenca = 0;
end;

end.
