unit Controller.Usuario;

interface

uses
  Controller.Usuario.Interfaces,
  Model.Usuario.Factory,
  Model.Usuario.Interfaces,
  Model.Usuario,
  Model.Entity.Usuario.Interfaces;

type
  TControllerUsuario = class(TInterfacedObject, iControllerUsuario)
  private
    FModelUsuario: iUsuario;
    constructor Create;
  public
    destructor Destroy; override;
    class function New: iControllerUsuario;
    function Autenticar: Boolean;
    function UsuarioLogado: iEntityUsuario;
  end;

implementation

{ TControllerUsuario }

function TControllerUsuario.Autenticar: Boolean;
begin
  Result := FModelUsuario.Autenticar;
end;

constructor TControllerUsuario.Create;
begin
  FModelUsuario := TModelUsuario.New;
end;

destructor TControllerUsuario.Destroy;
begin

  inherited;
end;

class function TControllerUsuario.New: iControllerUsuario;
begin
  Result := Self.Create;
end;

function TControllerUsuario.UsuarioLogado: iEntityUsuario;
begin
Result := FModelUsuario.UsuarioLogado;
end;

end.
